# Cache rules (Netlify). Built JS/CSS file names change whenever their content does,
# so browsers keep them for a year. Fonts and media keep their names when replaced,
# so they get shorter lifetimes.
/js/*
  Cache-Control: public, max-age=31536000, immutable
/css/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=2592000
/hero/*
  Cache-Control: public, max-age=604800
/campaign/*
  Cache-Control: public, max-age=604800
