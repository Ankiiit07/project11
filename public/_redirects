# Firebase Auth sign-in helper, served from our own domain so Google sign-in
# works in browsers that block third-party storage (Safari, iOS, private windows).
/__/auth/*      https://cafe-at-once.firebaseapp.com/__/auth/:splat      200!
/__/firebase/*  https://cafe-at-once.firebaseapp.com/__/firebase/:splat  200!

# Built files that don't exist (e.g. from an older deploy) are a real 404,
# not the home page, so browsers never cache HTML as JavaScript.
/js/*       /index.html   404
/css/*      /index.html   404
/assets/*   /index.html   404

/*    /index.html   200
